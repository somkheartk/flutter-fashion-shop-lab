# Application
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# Database
DATABASE_TYPE=sqlite
DATABASE_PATH=./database.sqlite

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=3600

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
